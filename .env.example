# Server-only provider selection. Never put keys in NEXT_PUBLIC_* variables.
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# DeepSeek V4 Flash with thinking mode enabled at max effort by default.
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_REASONING_EFFORT=max

# Per upstream call. Resume analysis can use substantial reasoning time.
AI_REQUEST_TIMEOUT_MS=600000

# Only required when AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
